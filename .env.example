# Copy to .env.local and fill in. For local dev, run `supabase start` and paste the
# printed API_URL + ANON_KEY. In Netlify, set these as build-time env vars.
#
# The anon key is public by design: it authenticates only anonymous reads, which RLS
# limits to the public SELECT policies. Every write requires a PIN session (Phase 5).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here
